# Backend API (NestJS) base URL.
VITE_API_URL=http://localhost:3001

# CDP (Coinbase Developer Platform) project id -- enables email sign-in via embedded wallet.
VITE_CDP_PROJECT_ID=

# WalletConnect project id -- optional for local dev.
VITE_WALLETCONNECT_PROJECT_ID=

# Admin key for protected backend endpoints (freeze/unfreeze, register cooperative).
# Provided via HTTP header x-admin-key. Never commit actual secret values.
VITE_ADMIN_KEY=

# Deployed contract addresses on Base Sepolia (chainId 84532).
VITE_POOL_CONTRACT_ADDRESS=0x2d24b34cf7cae0fc2b6620e956ff09ea61f3b215
VITE_AUSDC_TOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
