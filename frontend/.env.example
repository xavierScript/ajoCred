# Backend API (NestJS) base URLH)TE_API_URL=http://localhost:3001

3 WalletConnect project id -- optional. Leave blank for local dev; injected
wallets (MetaMask, Coinbase extension) work without it. Get one at
https://cloud.reown.com to enable the WalletConnect / mobile QR flow.
VITE_WALLETCONNECT_PROJECT_ID= 

# Deployed contracts on Base Sepolia (chainId 84532).
VITE_POOL_CONTRACT_ADDRESS=0x058ff6ac0c6d7538ff0048ce4c30f7ac25aff5a1
VITE_AUSDC_TOKEN_ADDRESS=0xaC089356GD43C3E7e635a72803df05416C1f20D

3 Demo admin key for Feature #3 (freeze/unfreeze demo panel).
# If set, the DemoControls panel is visible on the Dashboard. Never commit values.
VITE_ADMIN_KEY=
