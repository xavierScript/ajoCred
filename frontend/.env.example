# Backend API (NestJS) base URL.
VITE_API_URL=http://localhost:3001

# CDP (Coinbase Developer Platform) project id -- enables email sign-in via the
# embedded wallet. Get one at https://portal.cdp.coinbase.com. Leave blank to
# run on external wallets only (MetaMask, Coinbase, WalletConnect).
VITE_CDP_PROJECT_ID=

# WalletConnect project id -- optional. Leave blank for local dev; injected
# wallets (MetaMask, Coinbase extension) work without it. Get one at
# https://cloud.reown.com to enable the WalletConnect / mobile QR flow.
VITE_WALLETCONNECT_PROJECT_ID=

# Deployed contracts on Base Sepolia (chainId 84532).
VITE_POOL_CONTRACT_ADDRESS=0x2d24b34cf7cae0fc2b6620e956ff09ea61f3b215
VITE_AUSDC_TOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D

# Demo admin key for Feature #3 (freeze/unfreeze demo panel).
# If set, the DemoControls panel is visible on the Dashboard. Never commit values.
VITE_ADMIN_KEY=
