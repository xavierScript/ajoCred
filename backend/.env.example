# Compress for the demo, e.g. OBSERVATION_WINDOW_SECONDS=3600 and MIN_QUALIFYING_DEPOSITS=2.
OBSERVATION_WINDOW_SECONDS=
MIN_QUALIFYING_DEPOSITS=
